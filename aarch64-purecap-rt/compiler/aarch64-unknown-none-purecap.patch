From 7f2cfc03235586920da9a0261a049de1d13559df Mon Sep 17 00:00:00 2001
From: Irina Nita <irina.nita@posteo.com>
Date: Sat, 21 Mar 2026 16:46:40 +0200
Subject: [PATCH] Added support for aarch64-unknown-none

---
 clang++-morello.sh                            |  2 +-
 clang-morello.sh                              |  2 +-
 .../src/spec/aarch64_unknown_none_purecap.rs  | 35 +++++++++++++++++++
 compiler/rustc_target/src/spec/mod.rs         |  1 +
 4 files changed, 38 insertions(+), 2 deletions(-)
 create mode 100644 compiler/rustc_target/src/spec/aarch64_unknown_none_purecap.rs

diff --git a/clang++-morello.sh b/clang++-morello.sh
index 51d2ecb67fd..f1440e69999 100755
--- a/clang++-morello.sh
+++ b/clang++-morello.sh
@@ -4,4 +4,4 @@
 # See config.toml.sarah for more information.
 source $(dirname "$0")/cheri-config.sh
 
-$CHERI_HOME/output/morello-sdk/bin/clang++ --sysroot $CHERI_HOME/output/rootfs-morello-purecap/ -target aarch64-unknown-freebsd -march=morello+c64 -mabi=purecap "$@"
+$CHERI_HOME/output/morello-sdk/bin/clang++ --sysroot $CHERI_HOME/output/rootfs-morello-purecap/ -target aarch64-unknown-none -march=morello+c64 -mabi=purecap "$@"
diff --git a/clang-morello.sh b/clang-morello.sh
index 5a333a7d31a..37ef083cdad 100755
--- a/clang-morello.sh
+++ b/clang-morello.sh
@@ -4,4 +4,4 @@
 # See config.toml.sarah for more information.
 source $(dirname "$0")/cheri-config.sh
 
-$CHERI_HOME/output/morello-sdk/bin/clang --sysroot $CHERI_HOME/output/rootfs-morello-purecap/ -target aarch64-unknown-freebsd -march=morello+c64 -mabi=purecap "$@"
+$CHERI_HOME/output/morello-sdk/bin/clang --sysroot $CHERI_HOME/output/rootfs-morello-purecap/ -target aarch64-unknown-none -march=morello+c64 -mabi=purecap "$@"
diff --git a/compiler/rustc_target/src/spec/aarch64_unknown_none_purecap.rs b/compiler/rustc_target/src/spec/aarch64_unknown_none_purecap.rs
new file mode 100644
index 00000000000..02ec042eb6b
--- /dev/null
+++ b/compiler/rustc_target/src/spec/aarch64_unknown_none_purecap.rs
@@ -0,0 +1,35 @@
+// AArch64 Morello bare-metal target with pure-capability CHERI ABI
+//
+// For running purecap Rust code on Morello hardware without an OS —
+// useful for firmware, kernels, embedded, or research.
+
+use super::{
+    Cc, LinkerFlavor, Lld, MergeFunctions, PanicStrategy, RelocModel, Target, TargetOptions,
+};
+
+pub fn target() -> Target {
+    Target {
+        llvm_target: "aarch64-unknown-none".into(),
+        pointer_data_size: 64,
+        pointer_memory_size: 128,
+        data_layout: "e-m:e-pf200:128:128:128:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-A200-P200-G200".into(),
+        arch: "aarch64".into(),
+        options: TargetOptions {
+            linker_flavor: LinkerFlavor::Gnu(Cc::No, Lld::Yes),
+            linker: Some("rust-lld".into()),
+            features: "+morello,+c64".into(),
+            llvm_abiname: "purecap".into(),
+            abi: "purecap".into(),
+            max_atomic_width: Some(128),
+            // Atomic pointers are supported and converting to integers
+            // invalidates capabilities so we *must* use atomic pointers.
+            atomic_pointers_via_integers: false,
+            // TODO: figure out why this optimisation causes crashes when building libc.
+            merge_functions: MergeFunctions::Disabled,
+            relocation_model: RelocModel::Static,
+            disable_redzone: true,
+            panic_strategy: PanicStrategy::Abort,
+            ..Default::default()
+        },
+    }
+}
diff --git a/compiler/rustc_target/src/spec/mod.rs b/compiler/rustc_target/src/spec/mod.rs
index 1eeed1de631..faca58e78de 100644
--- a/compiler/rustc_target/src/spec/mod.rs
+++ b/compiler/rustc_target/src/spec/mod.rs
@@ -1440,6 +1440,7 @@ fn $module() {
 
     ("aarch64-unknown-none", aarch64_unknown_none),
     ("aarch64-unknown-none-softfloat", aarch64_unknown_none_softfloat),
+    ("aarch64-unknown-none-purecap", aarch64_unknown_none_purecap),
 
     ("x86_64-fortanix-unknown-sgx", x86_64_fortanix_unknown_sgx),
 
